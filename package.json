{
  "name": "activitylog-web",
  "version": "1.0.0",
  "description": "Web app to analyze swim, bike and run activity data imported from .FIT files (ActivityLog2 web port)",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "seed:fit": "node --env-file-if-exists=.env server/seed-fit.js",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "echarts": "^6.0.0",
    "express": "^4.21.2",
    "fit-file-parser": "^6.2.3",
    "leaflet": "^1.9.4",
    "multer": "^2.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "jsdom": "^30.1.3",
    "vite": "^7.0.0"
  }
}
